<Window x:Class="Colorlog.Views.EditProfileView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Colorlog.ViewModels"
        mc:Ignorable="d"
        Title="프로필 수정"
        Width="420"
        SizeToContent="Height"
        MinHeight="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance vm:EditProfileViewModel, IsDesignTimeCreatable=True}">

    <Border Padding="20" Background="Transparent">
        <Border CornerRadius="20"
                Background="{StaticResource WhiteBrush}"
                BorderBrush="{StaticResource NeutralBorderBrush}"
                BorderThickness="1"
                Padding="24,20,24,24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="{StaticResource ShadowSlate900Color}" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 커스텀 타이틀 바 (드래그) -->
                <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
                    <TextBlock Text="프로필 수정"
                               Style="{StaticResource DashboardCardTitleStyle}"
                               FontSize="20"
                               VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="이름과 생년월일을 입력하면 만 나이가 자동으로 계산되어 설정 화면에 반영됩니다."
                           Style="{StaticResource DashboardCardSubTextStyle}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                    <TextBlock Text="사용자 이름" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                    <Border CornerRadius="10"
                            BorderBrush="{StaticResource NeutralBorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource WhiteBrush}">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="12,10"
                                 FontSize="14"
                                 Foreground="{StaticResource TitleTextBrush}"
                                 MaxLength="40"/>
                    </Border>

                    <TextBlock Text="생년월일" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,6"/>
                    <Border CornerRadius="10"
                            BorderBrush="{StaticResource NeutralBorderBrush}"
                            BorderThickness="1"
                            Background="{StaticResource WhiteBrush}"
                            Padding="4,2">
                        <DatePicker SelectedDate="{Binding BirthDate, Mode=TwoWay}"
                                    FontSize="14"
                                    Foreground="{StaticResource TitleTextBrush}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    VerticalContentAlignment="Center"
                                    SelectedDateFormat="Long"
                                    Language="ko-KR"/>
                    </Border>
                    <TextBlock Text="{Binding CalculatedAgeText}"
                               Style="{StaticResource DashboardCardSubTextStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="취소"
                            Style="{StaticResource OutlineButtonStyle}"
                            MinWidth="88"
                            Height="36"
                            Padding="16,0"
                            Command="{Binding CancelCommand}"/>
                    <Button Content="저장"
                            Style="{StaticResource PrimaryButtonStyle}"
                            MinWidth="88"
                            Height="36"
                            Padding="16,0"
                            Margin="10,0,0,0"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
