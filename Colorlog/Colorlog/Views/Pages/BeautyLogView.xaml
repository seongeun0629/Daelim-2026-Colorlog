<UserControl x:Class="Colorlog.Views.Pages.BeautyLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <DataTemplate x:Key="MakeupProductCardTemplate">
            <Border Style="{StaticResource ProductCardContainerStyle}">
                <!-- 한 장의 면: 위만 강조색, 경계는 수평 직선(아래는 면색). 테두리 곡선은 카드와 동일 -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFF8A8A" Offset="0"/>
                        <GradientStop Color="#FFFF8A8A" Offset="0.028"/>
                        <GradientStop Color="#FFFCFCFD" Offset="0.028"/>
                        <GradientStop Color="#FFFCFCFD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="14,16,14,14" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Category}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Border Grid.Column="1" VerticalAlignment="Top" Background="{StaticResource RoseSoftBackgroundBrush}" BorderBrush="{StaticResource RoseBadgeBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                            <TextBlock Text="{Binding Rating, StringFormat=★ {0}}" Foreground="{StaticResource RoseEmphasisTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding RecommendationReason}" Margin="0,8,0,8" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecommendationReason}"/>

                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChipStyle}">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource CaptionOnNeutralBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="자세히 보려면 카드에 마우스를 올려보세요."/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SkinCareProductCardTemplate">
            <Border Style="{StaticResource ProductCardContainerStyle}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF4CAF50" Offset="0"/>
                        <GradientStop Color="#FF4CAF50" Offset="0.028"/>
                        <GradientStop Color="#FFFCFCFD" Offset="0.028"/>
                        <GradientStop Color="#FFFCFCFD" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="14,16,14,14" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Category}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Border Grid.Column="1" VerticalAlignment="Top" Background="{StaticResource SuccessSoftBackgroundBrush}" BorderBrush="{StaticResource SuccessSoftBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,3">
                            <TextBlock Text="{Binding Rating, StringFormat=★ {0}}" Foreground="{StaticResource SuccessDeepTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding RecommendationReason}" Margin="0,8,0,8" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecommendationReason}"/>

                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagChipStyle}">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource CaptionOnNeutralBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="자세히 보려면 카드에 마우스를 올려보세요."/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Margin="{StaticResource AppShellPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Beauty Log" Style="{StaticResource PageHeaderTitleStyle}"/>
                <TextBlock Text="{Binding UserDisplayName, StringFormat={}{0}님을 위한 톤/피부 맞춤 추천 요약}" Style="{StaticResource PageHeaderSubtitleStyle}"/>
                <TextBlock Text="추천은 최근 톤 분석/피부 컨디션 기준으로 매일 업데이트됩니다." Style="{StaticResource PageHeaderHintStyle}"/>
            </StackPanel>

            <Border x:Name="BeautyCriteriaCard" Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="10,10,10,16">
                <StackPanel>
                    <TextBlock Text="오늘의 추천 기준" Style="{StaticResource BeautyHeaderStyle}"/>
                    <TextBlock Text="{Binding ToneSummary}" Margin="0,8,0,0" FontSize="14" 
                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding SkinConditionSummary}" Margin="0,8,0,8" 
                               Style="{StaticResource BeautySubStyle}"/>

                    <ItemsControl ItemsSource="{Binding FocusKeywords}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="10,5" 
                                        Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource NeutralBorderBrush}" 
                                        BorderThickness="1" CornerRadius="12">
                                    <TextBlock Text="{Binding}" FontSize="12" 
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="BeautyTabsCard" Grid.Row="2" Style="{StaticResource DashboardCardStyle}" Margin="10,0,10,10">
                <TabControl Style="{StaticResource BeautyTabControlStyle}" Background="Transparent" 
                            BorderThickness="0" ItemContainerStyle="{StaticResource BeautyTabItemStyle}" 
                            UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <TabItem Header="🎨 색조 메이크업">
                        <StackPanel Margin="8,16,0,0">
                            <TextBlock Text="톤 매칭률과 발색 지속력이 좋은 제품 추천" 
                                       Style="{StaticResource BeautySubStyle}" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding MakeupItems}" 
                                          ItemTemplate="{StaticResource MakeupProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="🧴 기초 스킨케어">
                        <StackPanel Margin="8,16,0,0">
                            <TextBlock Text="수분/진정/장벽 중심으로 오늘 상태에 맞춘 제품 추천" 
                                       Style="{StaticResource BeautySubStyle}" Margin="0,0,0,16"/>
                            <ItemsControl ItemsSource="{Binding SkinCareItems}" 
                                          ItemTemplate="{StaticResource SkinCareProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
