<UserControl x:Class="Colorlog.Views.Pages.BeautyLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- 방사형·비대칭 크롬: AppStyles (MakeupProductCardRadialBacklightBrush, BeautyProductCardChromeStyle) -->

        <DataTemplate x:Key="MakeupProductCardTemplate">
            <Border Style="{StaticResource ProductCardContainerStyle}"
                Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                          Command="{Binding DataContext.ShowDetailCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"/>
                </Border.InputBindings>
                
                <Border Style="{StaticResource BeautyProductCardChromeStyle}">
                    <Grid ClipToBounds="True">
                        <Border CornerRadius="20" Background="#14FFFFFF"/>
                        <Border CornerRadius="20" Background="{StaticResource MakeupProductCardRadialBacklightBrush}"/>
                        <Border CornerRadius="20"
                                Background="{StaticResource FrostedGlassSheenBrush}"
                                IsHitTestVisible="False"/>

                        <StackPanel Margin="22,20,20,20" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" 
                                        FontSize="16" FontWeight="SemiBold" 
                                        Foreground="{StaticResource TitleTextBrush}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource DataEmphasisBrush}" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Border Grid.Column="1" VerticalAlignment="Top" Padding="10,5"
                                    Style="{StaticResource FrostedGlassNestedStyle}">

                                <TextBlock Text="{Binding Rating, StringFormat=★ {0}}"
                                           Foreground="{StaticResource RoseEmphasisTextBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                            <TextBlock Text="{Binding RecommendationReason}"
                                       Margin="0,10,0,8"
                                       MaxHeight="40"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource ProductRecommendationReasonStyle}"/>


                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChipStyle}">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource CaptionOnNeutralBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0,10,0,0"
                                    Height="34"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="OliveyoungButton_Click"
                                    Tag="{Binding ProductUrl}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="올리브영에서 보기" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource CaptionTextBrush}"
                                   Text="추천 사유는 카드에 요약되어 표시됩니다."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SkinCareProductCardTemplate">
            <Border Style="{StaticResource ProductCardContainerStyle}"
            Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                  Command="{Binding DataContext.ShowDetailCommand,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Border Style="{StaticResource BeautyProductCardChromeStyle}">
                    <Grid ClipToBounds="True">
                        <Border CornerRadius="20" Background="#14FFFFFF"/>
                        <Border CornerRadius="20" Background="{StaticResource SkinCareProductCardRadialBacklightBrush}"/>
                        <Border CornerRadius="20"
                                Background="{StaticResource FrostedGlassSheenBrush}"
                                IsHitTestVisible="False"/>

                        <StackPanel Margin="22,20,20,20" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" 
                                        FontSize="16" FontWeight="SemiBold" 
                                        Foreground="{StaticResource TitleTextBrush}"
                                        TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Border Grid.Column="1" VerticalAlignment="Top" Padding="10,5"
                                    Style="{StaticResource FrostedGlassNestedStyle}">
                                    <TextBlock Text="{Binding Rating, StringFormat=★ {0}}"
                                           Foreground="{StaticResource SuccessDeepTextBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding RecommendationReason}"
                                        Margin="0,10,0,8"
                                        MaxHeight="40"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource ProductRecommendationReasonStyle}"/>


                            <ItemsControl ItemsSource="{Binding Tags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChipStyle}">
                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource CaptionOnNeutralBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Margin="0,10,0,0"
                                    Height="34"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="OliveyoungButton_Click"
                                    Tag="{Binding ProductUrl}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="올리브영에서 보기" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource CaptionTextBrush}"
                                   Text="추천 사유는 카드에 요약되어 표시됩니다."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">

            <Grid Background="Transparent" Margin="{StaticResource AppShellPagePadding}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderBottomMargin}">
                    <TextBlock Text="Beauty Log" Style="{StaticResource PageHeaderTitleStyle}"/>
                    <TextBlock Text="{Binding UserDisplayName, StringFormat={}{0}님을 위한 톤/피부 맞춤 추천 요약}" Style="{StaticResource PageHeaderSubtitleStyle}"/>
                    <TextBlock Text="추천은 최근 톤 분석/피부 컨디션 기준으로 매일 업데이트됩니다." Style="{StaticResource PageHeaderHintStyle}"/>
                </StackPanel>

                <Border x:Name="BeautyCriteriaCard" Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="오늘의 추천 기준" Style="{StaticResource BeautyHeaderStyle}"/>
                        <TextBlock Text="{Binding ToneSummary}" Margin="0,12,0,0" Style="{StaticResource DashboardAccentValueStyle}"/>
                        <TextBlock Text="{Binding SkinConditionSummary}" Margin="0,10,0,12"
                                   Style="{StaticResource BeautySubStyle}"/>
                    
                        <ItemsControl ItemsSource="{Binding FocusKeywords}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,10" Padding="12,8" Style="{StaticResource LiquidGlassInsetStyle}">
                                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource BodyTextBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border x:Name="BeautyTabsCard" Grid.Row="2" Style="{StaticResource DashboardCardStyle}" Margin="0">
                    <TabControl Style="{StaticResource BeautyTabControlStyle}" Background="Transparent"
                                BorderThickness="0" ItemContainerStyle="{StaticResource BeautyTabItemStyle}"
                                UseLayoutRounding="True" SnapsToDevicePixels="True">

                        <TabItem Header="색조 메이크업">
                            <StackPanel Margin="4,20,0,0">
                                <TextBlock Text="톤 매칭률과 발색 지속력이 좋은 제품 추천"
                                           Style="{StaticResource BeautySubStyle}" Margin="0,0,0,20"/>
                            
                                <ItemsControl ItemsSource="{Binding MakeupItems}"
                                              ItemTemplate="{StaticResource MakeupProductCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </TabItem>

                        <TabItem Header="기초 스킨케어">
                            <StackPanel Margin="4,20,0,0">
                                <TextBlock Text="수분/진정/장벽 중심으로 오늘 상태에 맞춘 제품 추천"
                                           Style="{StaticResource BeautySubStyle}" Margin="0,0,0,20"/>
                                <ItemsControl ItemsSource="{Binding SkinCareItems}"
                                              ItemTemplate="{StaticResource SkinCareProductCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 오버레이 배경 -->
        <Border Background="#80000000"
                Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                MouseLeftButtonDown="Overlay_MouseLeftButtonDown"/>

        <!-- 팝업 카드 -->
        <Border Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                Width="480"
                MaxHeight="600"
                CornerRadius="20"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource AppShellBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="30" ShadowDepth="8" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <!-- 헤더 -->
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCard.Name}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TitleTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedCard.Category}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource DataEmphasisBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Content="✕" Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            FontSize="14"
                            Foreground="{StaticResource MutedTextBrush}"
                            Command="{Binding CloseDetailCommand}"
                            Cursor="Hand"/>
                </Grid>

                <!-- 별점 -->
                <Border Padding="12,6" HorizontalAlignment="Left"
                        CornerRadius="8"
                        Background="{StaticResource RoseSoftBackgroundBrush}"
                        Margin="0,0,0,16">
                    <TextBlock Text="{Binding SelectedCard.Rating, StringFormat=★ {0} / 5.0}"
                               Foreground="{StaticResource RoseEmphasisTextBrush}"
                               FontSize="14" FontWeight="SemiBold"/>
                </Border>

                <!-- 추천 이유 전체 -->
                <TextBlock Text="추천 이유" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleTextBrush}"
                           Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedCard.RecommendationReason}"
                               FontSize="13"
                               Foreground="{StaticResource BodyTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="22"/>
                </ScrollViewer>

                <!-- 올리브영 버튼 -->
                <Button Margin="0,20,0,0"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="OliveyoungButton_Click"
                        Tag="{Binding SelectedCard.ProductUrl}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛒" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="올리브영에서 보기" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

