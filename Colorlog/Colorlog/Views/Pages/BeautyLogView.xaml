<UserControl x:Class="Colorlog.Views.Pages.BeautyLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <DataTemplate x:Key="ProductCardTemplate">
            <Border Width="280" Margin="0,0,12,12" Padding="14" 
                    CornerRadius="14" Background="#FFFCFCFD" BorderBrush="#FFE5E7EB" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Category}" Margin="0,3,0,0" FontSize="12" 
                                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Border Grid.Column="1" VerticalAlignment="Top" Background="#FFFFF1F2" 
                                BorderBrush="#FFFECACA" BorderThickness="1" CornerRadius="12" Padding="8,3">
                            <TextBlock Text="{Binding Rating, StringFormat=★ {0}}" 
                                       Foreground="#FFBE123C" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding RecommendationReason}" Margin="0,10,0,10" FontSize="12" 
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,6,6" Padding="8,3" Background="#FFF3F4F6" 
                                        CornerRadius="10">
                                    <TextBlock Text="{Binding}" FontSize="11" 
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,12,12,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Beauty Log" FontSize="28" FontWeight="Bold" 
                           Foreground="{StaticResource TitleTextBrush}"/>
                <TextBlock Text="{Binding UserDisplayName, StringFormat={}{0}님을 위한 톤/피부 맞춤 추천 요약}" 
                           Margin="0,6,0,0" Style="{StaticResource BeautySubStyle}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,10,16">
                <StackPanel>
                    <TextBlock Text="오늘의 추천 기준" Style="{StaticResource BeautyHeaderStyle}"/>
                    <TextBlock Text="{Binding ToneSummary}" Margin="0,10,0,0" FontSize="14" 
                               FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="{Binding SkinConditionSummary}" Margin="0,6,0,10" 
                               Style="{StaticResource BeautySubStyle}"/>

                    <ItemsControl ItemsSource="{Binding FocusKeywords}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="10,5" 
                                        Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" 
                                        BorderThickness="1" CornerRadius="12">
                                    <TextBlock Text="{Binding}" FontSize="12" 
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,10,10">
                <TabControl Style="{StaticResource BeautyTabControlStyle}" Background="Transparent" 
                            BorderThickness="0" ItemContainerStyle="{StaticResource BeautyTabItemStyle}" 
                            UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <TabItem Header="🎨 색조 메이크업">
                        <StackPanel Margin="10,12,0,0">
                            <TextBlock Text="톤 매칭률과 발색 지속력이 좋은 제품 추천" 
                                       Style="{StaticResource BeautySubStyle}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding MakeupItems}" 
                                          ItemTemplate="{StaticResource ProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="🧴 기초 스킨케어">
                        <StackPanel Margin="10,12,0,0">
                            <TextBlock Text="수분/진정/장벽 중심으로 오늘 상태에 맞춘 제품 추천" 
                                       Style="{StaticResource BeautySubStyle}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding SkinCareItems}" 
                                          ItemTemplate="{StaticResource ProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
