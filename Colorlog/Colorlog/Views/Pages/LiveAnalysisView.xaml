<UserControl x:Class="Colorlog.Views.Pages.LiveAnalysisView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="820" d:DesignWidth="1180"
      Background="Transparent"
      Loaded="UserControl_Loaded"
      Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentOutlinePillButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleWhenTrueBorderStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AnalysisStatusLiveTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.55" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="Transparent">
        <Grid Background="Transparent" Margin="{StaticResource AppShellPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="{StaticResource PageHeaderBottomMargin}">
                <TextBlock Text="실시간 컬러 진단" Style="{StaticResource PageHeaderTitleStyle}"/>
                <TextBlock Text="카메라 가이드에 얼굴을 맞추면 피부톤/밝기/홍조를 실시간으로 분석합니다." Style="{StaticResource PageHeaderSubtitleStyle}"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,20,20" Padding="14">
                        <Grid ClipToBounds="True" MinHeight="420">
                            <Border CornerRadius="14" Background="{StaticResource CameraViewportFaceBrush}" ClipToBounds="True"/>

                            <Border CornerRadius="14"
                                    Background="{StaticResource CameraViewportVignetteBrush}"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False"/>
                            <Border CornerRadius="14"
                                    BorderBrush="{StaticResource LiquidGlassAsymmetricHighlightBrush}"
                                    BorderThickness="1.2,1,0.8,0"
                                    Opacity="0.42"
                                    IsHitTestVisible="False"/>

                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Border Background="{Binding CameraStateBrush}" Style="{StaticResource CameraStatusPillStyle}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CameraStateText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{Binding FaceStateBrush}" Style="{StaticResource CameraStatusPillStyle}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding FaceStateText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="{Binding LightingStateBrush}" Style="{StaticResource CameraStatusPillStyle}">
                                        <TextBlock Text="{Binding LightingStateText}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <!-- 뷰포트(640×480) 안에 영상·가이드·문구를 묶어 정렬이 깨지지 않게 함 -->
                                    <Grid Width="640" Height="480"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center">
                                    <!-- 영상은 VM에서 중앙 크롭·미러·640×480 처리 → UI는 중앙 정렬만 -->
                                    <Border CornerRadius="16"
                                            ClipToBounds="True"
                                            Background="Transparent"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <Image Source="{Binding CameraSource}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <Rectangle Width="360" Height="470"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stroke="{StaticResource CameraGuideFrameStrokeBrush}"
                                               StrokeThickness="2"
                                               RadiusX="32" RadiusY="32"
                                               StrokeDashArray="10 6"
                                               Fill="Transparent"
                                               Opacity="0.92"/>

                                    <Ellipse Width="220" Height="280"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Stroke="{StaticResource CameraGuideEllipseStrokeBrush}"
                                             StrokeThickness="1.25"
                                             Fill="Transparent"
                                             Opacity="0.88"/>

                                    <TextBlock Text="얼굴을 프레임 중앙에 맞춰주세요"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Bottom"
                                               Margin="0,0,0,40"
                                               Foreground="{StaticResource CameraGuideHintTextBrush}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               TextAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#CC000000" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource CameraGuidanceBarStyle}">
                                    <TextBlock Text="{Binding GuidanceMessage}"
                                               Foreground="{StaticResource CameraGuidanceBarTextBrush}"
                                               FontSize="12" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="진단 상태" Style="{StaticResource AnalysisCardTitleStyle}"/>
                            <TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource AnalysisStatusLiveTextStyle}"/>
                            <TextBlock Text="{Binding AnalysisStageText}" Margin="0,6,0,0" Style="{StaticResource AnalysisCardSubTextStyle}"/>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Height="12" Minimum="0" Maximum="100"
                                    Value="{Binding AnalysisProgress}">
                                    <ProgressBar.Style>
                                        <Style TargetType="ProgressBar" BasedOn="{StaticResource DashboardProgressBarStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiagnosisCompleted}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF16A34A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ProgressBar.Style>
                                </ProgressBar>
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AnalysisProgress, StringFormat={}{0:0}%}"/>
                            </Grid>

                            <!-- 버튼 영역 -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">

                                <!-- 진단 시작 -->
                                <Button Content="진단 시작" Width="120" Command="{Binding StartAnalysisCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDiagnosisCompleted}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 진단 중지 -->
                                <Button Content="진단 중지" Width="120" Margin="8,0,0,0"
            Command="{Binding StopAnalysisCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentOutlinePillButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 다시 진단 -->
                                <Button Content="다시 진단" Width="120" Margin="8,0,0,0"
            Command="{Binding StartAnalysisCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiagnosisCompleted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- 진단 완료 배지 -->
                                <Border Margin="12,0,0,0" VerticalAlignment="Center"
                                    Background="#F0FDF4" CornerRadius="20" Padding="12,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDiagnosisCompleted}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#16A34A"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="진단 완료" FontSize="12" FontWeight="SemiBold"
                                            Foreground="#16A34A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <Border DataContext="{Binding HasBlockingIssue}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GlassAlertErrorStyle}">
                                        <Setter Property="Margin" Value="0,12,0,0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding DataContext.BlockingIssueTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource GlassAlertErrorTitleBrush}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DataContext.BlockingIssueMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0" Foreground="{StaticResource GlassAlertErrorBodyBrush}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <Border DataContext="{Binding HasQualityWarning}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GlassAlertWarningStyle}">
                                        <Setter Property="Margin" Value="0,8,0,0"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DataContext.QualityWarningMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" Foreground="{StaticResource GlassAlertWarningBodyBrush}" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="촬영 전 체크" Style="{StaticResource AnalysisCardTitleStyle}"/>
                            <ItemsControl ItemsSource="{Binding PreCheckItems}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="10,6" Style="{StaticResource LiquidGlassInsetStyle}">
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="실시간 결과 미리보기" Style="{StaticResource AnalysisCardTitleStyle}"/>
                            <TextBlock Text="분석 중 감지되는 얼굴 부위별 색상값" Margin="0,8,0,14" Style="{StaticResource AnalysisCardSubTextStyle}"/>
                            <TextBlock Text="{Binding PreviewBasisText}" Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>

                            <ItemsControl ItemsSource="{Binding FaceTonePreviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="12" Style="{StaticResource LiquidGlassInsetStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="28" Height="28" CornerRadius="10" ClipToBounds="True"
                                                        BorderBrush="{StaticResource LiquidGlassAsymmetricHighlightSubtleBrush}"
                                                        BorderThickness="1,1,0.6,0">
                                                    <Rectangle Fill="{Binding ToneBrush}"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ZoneName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}"/>
                                                    <TextBlock Text="{Binding ColorHex}" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Style="{StaticResource GlassMetricBadgeStyle}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConfidencePercent, StringFormat=신뢰도 {0}%}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
