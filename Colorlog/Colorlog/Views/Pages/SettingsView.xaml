<UserControl x:Class="Colorlog.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Colorlog.Converter"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Margin="{StaticResource AppShellPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 페이지 헤더: 제목 + 설명 한 줄 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="서비스 설정" Style="{StaticResource PageHeaderTitleStyle}"/>
                <TextBlock Text="계정·스타일·카메라·추구미·데이터를 한 화면에서 관리하세요."
                           Style="{StaticResource PageHeaderSubtitleStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid x:Name="CardsLayoutGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 사용자 정보 -->
                <Border x:Name="UserInfoCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="사용자 정보" Style="{StaticResource DashboardCardTitleStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <StackPanel Width="110" HorizontalAlignment="Left">
                                <Border Width="96" Height="96" CornerRadius="48"
                                        BorderBrush="{StaticResource NeutralBorderBrush}" BorderThickness="2"
                                        HorizontalAlignment="Center">
                                    <Border.Clip>
                                        <EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48"/>
                                    </Border.Clip>
                                    <Image Source="pack://application:,,,/Assets/user.png" Stretch="UniformToFill"/>
                                </Border>
                                <Button Content="사진 변경"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Margin="0,10,0,0" Height="28" FontSize="12" Width="96"/>
                            </StackPanel>

                            <StackPanel Margin="20,8,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName, FallbackValue='유현성'}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TitleTextBrush}"/>
                                <TextBlock Text="{Binding UserAge, FallbackValue='24세'}"
                                           Style="{StaticResource DashboardCardSubTextStyle}"
                                           Margin="0,6,0,0"/>
                                <Button Content="정보 수정"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Width="90"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource NeutralBorderBrush}" Margin="0,20,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="퍼스널 컬러"
                                           Style="{StaticResource DashboardCardSubTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <Border Background="{StaticResource RoseSelectedBackgroundBrush}" BorderBrush="{StaticResource RoseSelectedBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="10,4"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PersonalColorName, FallbackValue='봄 웜 라이트'}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource RoseEmphasisTextBrush}"/>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="0" Width="1" Background="{StaticResource NeutralBorderBrush}"
                                    HorizontalAlignment="Right" Margin="0,4"/>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="총 진단 횟수"
                                           Style="{StaticResource DashboardCardSubTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding DiagnosisCount, FallbackValue='12회'}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TitleTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{StaticResource NeutralBorderBrush}"
                                    HorizontalAlignment="Right" Margin="0,4"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="가입일"
                                           Style="{StaticResource DashboardCardSubTextStyle}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding JoinDate, FallbackValue='2026.01.03'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TitleTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 카메라 / 조명 -->
                <Border x:Name="CameraSettingsCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="카메라 / 조명 설정" Style="{StaticResource DashboardCardTitleStyle}"/>
                        <TextBlock Text="촬영 장치와 밝기를 맞추면 분석 결과가 더 안정적입니다."
                                   Style="{StaticResource DashboardCardSubTextStyle}"
                                   Margin="0,8,0,0"/>

                        <Border x:Name="PreviewHost"
                                CornerRadius="12" Background="{StaticResource SurfaceMutedBrush}"
                                Height="150" Margin="0,16,0,0"
                                BorderBrush="{StaticResource NeutralBorderBrush}" BorderThickness="1"
                                ClipToBounds="True"
                                SizeChanged="PreviewHost_SizeChanged">
                            <Grid>
                                <Image x:Name="WebcamPreviewImage" Stretch="UniformToFill"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Viewbox Width="112" Height="84" Stretch="Uniform" Margin="0,0,0,10" Opacity="0.2">
                                        <Path Fill="{StaticResource MutedTextBrush}"
                                              Stretch="Uniform"
                                              Data="M12,15.2A3.2,3.2,0,1,1,15.2,12,3.2,3.2,0,0,1,12,15.2 M9,2L7.17,4H4A2,2,0,0,0,2,6V18A2,2,0,0,0,4,20H20A2,2,0,0,0,22,18V6A2,2,0,0,0,20,4H16.83L15,2H9 M12,17A5,5,0,1,0,7,12,5,5,0,0,0,12,17Z"/>
                                    </Viewbox>
                                    <TextBlock Text="카메라 미리보기"
                                               Style="{StaticResource DashboardCardSubTextStyle}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                    <TextBlock Text="연결되면 이 영역에 영상이 표시됩니다."
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="카메라" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid Grid.Column="1" MinHeight="32">
                                <ComboBox ItemsSource="{Binding CameraNames}"
                                          SelectedItem="{Binding SelectedCameraName, Mode=TwoWay}"
                                          Visibility="{Binding HasCameras, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="사용 가능한 카메라가 없습니다."
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasCameras, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Grid Width="24" Height="24" SnapsToDevicePixels="True">
                                        <!-- 축·대각 광선 끝을 5~19로 맞춰 가로·세로 동일 스팬(정사각형 실루엣) -->
                                        <Path Stroke="{StaticResource MutedTextBrush}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Opacity="0.9"
                                              Data="M12,5 L12,8 M12,16 L12,19 M5,12 L8,12 M16,12 L19,12 M6.75,6.75 L9,9 M17.25,6.75 L15,9 M6.75,17.25 L9,15 M17.25,17.25 L15,15"/>
                                        <Ellipse Width="6.5" Height="6.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{StaticResource MutedTextBrush}" Opacity="0.35"/>
                                        <Ellipse Width="4" Height="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Fill="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="밝기" Style="{StaticResource FieldLabelStyle}"/>
                            </StackPanel>
                            <Slider Grid.Column="1" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100"
                                    Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource LightSliderStyle}"/>
                            <TextBlock Grid.Column="2"
                                       MinWidth="28"
                                       Text="{Binding Brightness, StringFormat={}{0:0}}"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 추구미 -->
                <Border x:Name="PreferenceCard" Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="추구미" Style="{StaticResource DashboardCardTitleStyle}"/>
                        <TextBlock Text="선호하는 스타일을 골라보세요. (복수 선택 가능)"
                                   Style="{StaticResource DashboardCardSubTextStyle}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding PreferenceSelectionSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>

                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="분위기" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding MoodItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource NeutralBorderBrush}" Margin="0,14,0,14"/>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="피부 표현" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding SkinItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource NeutralBorderBrush}" Margin="0,14,0,14"/>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="톤" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding ToneItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ToggleButton Content="{Binding Label}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource FilterToggleStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 데이터 관리 -->
                <Border x:Name="DataManagementCard" Grid.Row="2" Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="데이터 관리" Style="{StaticResource DashboardCardTitleStyle}"/>
                        <TextBlock Text="기록을 비우거나 파일로 보낼 수 있습니다."
                                   Style="{StaticResource DashboardCardSubTextStyle}"
                                   Margin="0,8,0,0"/>

                        <Border Background="Transparent"
                                BorderBrush="{StaticResource DangerSubtleSectionBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="모든 기록 초기화"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleTextBrush}"/>
                                    <TextBlock Text="진단 기록, 추천 내역을 모두 삭제합니다"
                                               Style="{StaticResource DashboardCardSubTextStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="초기화"
                                        Style="{StaticResource DangerSolidButtonStyle}"
                                        VerticalAlignment="Center"
                                        Command="{Binding ResetAllRecordsCommand}"/>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource NeutralBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="데이터 백업"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleTextBrush}"/>
                                    <TextBlock Text="현재 분석 결과 및 기록을 파일로 보냅니다"
                                               Style="{StaticResource DashboardCardSubTextStyle}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="백업"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Height="32" VerticalAlignment="Center"
                                        Command="{Binding ExportBackupCommand}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
