<UserControl x:Class="Colorlog.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Colorlog.Views.Pages"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1000"
             Background="Transparent"
             Loaded="UserControl_Loaded">

	<UserControl.Resources>

		<!-- 섹션 타이틀 스타일 -->
		<Style x:Key="SectionTitleStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
		</Style>

		<!-- 설정 라벨 스타일 -->
		<Style x:Key="FieldLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- 추구미 그룹 레이블 -->
		<Style x:Key="VibeGroupLabelStyle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
			<Setter Property="Margin" Value="2,0,0,6"/>
		</Style>

		<!-- 추구미 토글 버튼 스타일 -->
		<Style x:Key="VibeToggleStyle" TargetType="ToggleButton">
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="Padding" Value="12,6"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Background" Value="#FFF5F5F5"/>
			<Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
			<Setter Property="BorderBrush" Value="#FFE5E7EB"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ToggleButton">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="border" Property="Background" Value="#FFFCE4E8"/>
								<Setter TargetName="border" Property="BorderBrush" Value="#FFE08E9B"/>
								<Setter Property="Foreground" Value="#FFBE123C"/>
								<Setter Property="FontWeight" Value="SemiBold"/>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#FFFFF1F2"/>
								<Setter TargetName="border" Property="BorderBrush" Value="#FFFECDD3"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 아웃라인 버튼 스타일 -->
		<Style x:Key="OutlineButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="32"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="14,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#FFFFF1F2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 위험 아웃라인 버튼 (초기화) -->
		<Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="32"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Foreground" Value="#FFDC2626"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="#FFFCA5A5"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="14,0">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="border" Property="Background" Value="#FFFFF1F2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- 슬라이더 스타일 -->
		<Style x:Key="LightSliderStyle" TargetType="Slider">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Slider">
						<Grid>
							<Track x:Name="PART_Track">
								<Track.DecreaseRepeatButton>
									<RepeatButton Command="Slider.DecreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.DecreaseRepeatButton>
								<Track.IncreaseRepeatButton>
									<RepeatButton Command="Slider.IncreaseLarge">
										<RepeatButton.Template>
											<ControlTemplate TargetType="RepeatButton">
												<Border Height="4" CornerRadius="2" Background="#FFE5E7EB"/>
											</ControlTemplate>
										</RepeatButton.Template>
									</RepeatButton>
								</Track.IncreaseRepeatButton>
								<Track.Thumb>
									<Thumb>
										<Thumb.Template>
											<ControlTemplate TargetType="Thumb">
												<Ellipse Width="16" Height="16" Fill="White"
                                                         Stroke="{StaticResource PrimaryBrush}"
                                                         StrokeThickness="2"/>
											</ControlTemplate>
										</Thumb.Template>
									</Thumb>
								</Track.Thumb>
							</Track>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>

	<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
		<Grid Margin="24,12,12,24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- ── 페이지 헤더 ── -->
			<StackPanel Grid.Row="0" Margin="0,0,0,18">
				<TextBlock Text="서비스 설정" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TitleTextBrush}"/>
				<TextBlock Text="계정 정보, 스타일 선호도, 카메라 환경을 관리하세요"
                           FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
			</StackPanel>

			<!-- ── 메인 컨텐츠 그리드 ── -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="16"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

				<!--왼쪽 상단: 사용자 정보 카드-->
				<Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
					<StackPanel>

						<TextBlock Text="👤  사용자 정보" Style="{StaticResource SectionTitleStyle}"/>

						<!-- 프로필: 사진 + 이름/나이 -->
						<StackPanel Orientation="Horizontal" Margin="0,4,0,0">

							<!-- 원형 프로필 사진 -->
							<StackPanel Width="110" HorizontalAlignment="Left">
								<Border Width="96" Height="96" CornerRadius="48"
                                        BorderBrush="#FFFECDD3" BorderThickness="3"
                                        HorizontalAlignment="Center">
									<Border.Clip>
										<EllipseGeometry Center="48,48" RadiusX="48" RadiusY="48"/>
									</Border.Clip>
									<Image Source="/user.png" Stretch="UniformToFill"/>
								</Border>
								<Button Content="사진 변경"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Margin="0,10,0,0" Height="28" FontSize="12" Width="96"/>
							</StackPanel>

							<!-- 이름 / 나이 / 수정 버튼 -->
							<StackPanel Margin="20,8,0,0" VerticalAlignment="Center">
								<TextBlock Text="{Binding UserName, FallbackValue='유현성'}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TitleTextBrush}"/>
								<TextBlock Text="{Binding UserAge, FallbackValue='24세'}"
                                           FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,5,0,0"/>
								<Button Content="정보 수정"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Width="90"
                                        Margin="0,16,0,0"/>
							</StackPanel>
						</StackPanel>

						<!-- 구분선 -->
						<Border Height="1" Background="#FFE5E7EB" Margin="0,20,0,18"/>

						<!-- 하단 통계 3칸 -->
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- 퍼스널 컬러 -->
							<StackPanel Grid.Column="0" HorizontalAlignment="Center">
								<TextBlock Text="퍼스널 컬러" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
								<Border Background="#FFFCE4E8" BorderBrush="#FFE08E9B"
                                        BorderThickness="1" CornerRadius="12" Padding="10,4"
                                        HorizontalAlignment="Center">
									<TextBlock Text="{Binding PersonalColorName, FallbackValue='봄 웜 라이트'}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FFBE123C"/>
								</Border>
							</StackPanel>

							<!-- 세로 구분선 -->
							<Border Grid.Column="0" Width="1" Background="#FFE5E7EB"
                                    HorizontalAlignment="Right" Margin="0,4"/>

							<!-- 진단 횟수 -->
							<StackPanel Grid.Column="1" HorizontalAlignment="Center">
								<TextBlock Text="총 진단 횟수" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
								<TextBlock Text="{Binding DiagnosisCount, FallbackValue='12회'}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TitleTextBrush}"
                                           HorizontalAlignment="Center"/>
							</StackPanel>

							<!-- 세로 구분선 -->
							<Border Grid.Column="1" Width="1" Background="#FFE5E7EB"
                                    HorizontalAlignment="Right" Margin="0,4"/>

							<!-- 가입일 -->
							<StackPanel Grid.Column="2" HorizontalAlignment="Center">
								<TextBlock Text="가입일" FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
								<TextBlock Text="{Binding JoinDate, FallbackValue='2026.01.03'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TitleTextBrush}"
                                           HorizontalAlignment="Center"/>
							</StackPanel>
						</Grid>

					</StackPanel>
				</Border>

				<!--오른쪽 상단: 카메라 / 조명 설정-->
				<Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
					<StackPanel>

						<TextBlock Text="📷  카메라 / 조명 설정" Style="{StaticResource SectionTitleStyle}"/>

						<!-- 웹캠 미리보기 -->
						<Border CornerRadius="12" Background="#FFF3F4F6"
                                Height="150" Margin="0,4,0,0"
                                BorderBrush="#FFE5E7EB" BorderThickness="1">
							<Grid>
								<Image x:Name="웹캠_화면" Stretch="UniformToFill">
									<Image.Clip>
										<RectangleGeometry Rect="0,0,600,150" RadiusX="12" RadiusY="12"/>
									</Image.Clip>
								</Image>
								<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
									<TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center"/>
									<TextBlock Text="카메라 미리보기" FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
								</StackPanel>
							</Grid>
						</Border>

						<!-- 카메라 선택 -->
						<Grid Margin="0,16,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="80"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="카메라" Style="{StaticResource FieldLabelStyle}"/>
							<ComboBox Grid.Column="1"
                                      Height="32" FontSize="13"
                                      VerticalContentAlignment="Center"
                                      BorderBrush="#FFE5E7EB" BorderThickness="1"/>

						</Grid>

						<!-- 조명 밝기 슬라이더 -->
						<Grid Margin="0,14,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="80"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="30"/>
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
								<Image Height="18" Width="18" Source="/light.png" Stretch="Fill" Margin="0,0,6,0"/>
								<TextBlock Text="밝기" Style="{StaticResource FieldLabelStyle}"/>
							</StackPanel>
							<Slider Grid.Column="1" VerticalAlignment="Center"
                                    Minimum="0" Maximum="100" Value="60"
                                    Style="{StaticResource LightSliderStyle}"/>
							<TextBlock Grid.Column="2" Text="60" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
						</Grid>
					</StackPanel>
				</Border>

				<!--왼쪽 하단: 추구미 (3줄 그룹) -->
				<Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}">
					<StackPanel>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
							<TextBlock Text="✨  추구미" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
							<TextBlock Text="선호하는 스타일을 골라보세요 (복수 선택 가능)"
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,2"/>
						</StackPanel>

						<!-- 그룹 1: 분위기 -->
						<Border Background="#FFF9FAFB" CornerRadius="10"
                                Padding="10,8" Margin="0,0,0,8">
							<StackPanel>
								<TextBlock Text="분위기" Style="{StaticResource VibeGroupLabelStyle}"/>
								<StackPanel Orientation="Horizontal">
									<ToggleButton Content="청순" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="화려" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="스모키" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="러블리" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="시크" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="데일리" Style="{StaticResource VibeToggleStyle}"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- 그룹 2: 피부 표현 -->
						<Border Background="#FFF9FAFB" CornerRadius="10"
                                Padding="10,8" Margin="0,0,0,8">
							<StackPanel>
								<TextBlock Text="피부 표현" Style="{StaticResource VibeGroupLabelStyle}"/>
								<StackPanel Orientation="Horizontal">
									<ToggleButton Content="글로우" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="매트" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="세미매트" Style="{StaticResource VibeToggleStyle}"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<!-- 그룹 3: 톤 -->
						<Border Background="#FFF9FAFB" CornerRadius="10"
                                Padding="10,8">
							<StackPanel>
								<TextBlock Text="톤" Style="{StaticResource VibeGroupLabelStyle}"/>
								<StackPanel Orientation="Horizontal">
									<ToggleButton Content="웜톤" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="쿨톤" Style="{StaticResource VibeToggleStyle}"/>
									<ToggleButton Content="뉴트럴톤" Style="{StaticResource VibeToggleStyle}"/>
								</StackPanel>
							</StackPanel>
						</Border>

					</StackPanel>
				</Border>

				<!--오른쪽 하단: 데이터 관리 카드-->
				<Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
					<StackPanel>

						<TextBlock Text="🗂️  데이터 관리" Style="{StaticResource SectionTitleStyle}"/>

						<!-- 초기화 항목 -->
						<Border Background="#FFFFF8F8" BorderBrush="#FFFECDD3"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,4,0,0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="모든 기록 초기화"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#FFDC2626"/>
									<TextBlock Text="진단 기록, 추천 내역을 모두 삭제합니다"
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,0"/>
								</StackPanel>
								<Button Grid.Column="1"
                                        Content="초기화"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        Height="32" VerticalAlignment="Center"/>
							</Grid>
						</Border>

						<!-- 백업 항목 -->
						<Border Background="#FFF8FAFC" BorderBrush="#FFE5E7EB"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,10,0,0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="데이터 백업"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleTextBrush}"/>
									<TextBlock Text="현재 분석 결과 및 기록을 파일로 내보냅니다"
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,4,0,0"/>
								</StackPanel>
								<Button Grid.Column="1"
                                        Content="백업"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Height="32" VerticalAlignment="Center"/>
							</Grid>
						</Border>

					</StackPanel>
				</Border>

			</Grid>
		</Grid>
	</ScrollViewer>
</UserControl>