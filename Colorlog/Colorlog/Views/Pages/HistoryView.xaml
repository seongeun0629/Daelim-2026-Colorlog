<UserControl x:Class="Colorlog.Views.Pages.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:Colorlog.Converter"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             Background="Transparent"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Loaded="UserControl_Loaded"
             SizeChanged="UserControl_SizeChanged">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="HistorySegmentButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="CalendarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="CalendarDayCellButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6,6,6,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CellBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CellBorder" Property="Background" Value="{StaticResource SurfaceSubtleBrush}"/>
                                <Setter TargetName="CellBorder" Property="BorderBrush" Value="{StaticResource NeutralBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid Margin="{StaticResource AppShellPagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="컬러 히스토리" Style="{StaticResource PageHeaderTitleStyle}"/>
                <TextBlock Text="최근 피부 지표 흐름과 월별 퍼스널 컬러 기록을 한눈에 확인하세요."
                           Style="{StaticResource PageHeaderSubtitleStyle}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Grid x:Name="HistoryCardsLayoutGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 주간 트렌드 -->
                <Border x:Name="WeekHistoryCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="일주일 히스토리" Style="{StaticResource DashboardCardTitleStyle}"/>
                        <TextBlock Text="최근 7일 밝기·붉은기 추이"
                                   Style="{StaticResource DashboardCardSubTextStyle}"
                                   Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="밝기"
                                    Command="{Binding SelectBrightnessCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HistorySegmentButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowBrightness}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource RoseSoftBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="붉은기"
                                    Margin="8,0,0,0"
                                    Command="{Binding SelectRednessCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HistorySegmentButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowBrightness}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource RoseSoftBackgroundBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Grid.Column="0" Width="36" Margin="0,4,8,0" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding WeeklyYMaxLabel}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Text="{Binding WeeklyYMinLabel}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Grid.Row="0" Grid.Column="1"
                                    CornerRadius="12"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource NeutralBorderBrush}"
                                    BorderThickness="1"
                                    Padding="10,10,10,6"
                                    MinHeight="132">
                                <Canvas x:Name="WeeklyChartCanvas"
                                        Height="88"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top"
                                        Margin="0,4,0,0"
                                        ClipToBounds="True"
                                        SizeChanged="WeeklyChart_SizeChanged">
                                    <Path Data="{Binding WeeklyLineGeometry}"
                                          Stroke="{StaticResource PrimaryBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Border>
                            <ItemsControl Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding WeeklyTrend}"
                                          Margin="11,10,11,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DayLabel}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <TextBlock Text="{Binding WeeklyCaption}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0"/>

                        <Border Height="1" Background="{StaticResource NeutralBorderBrush}" Margin="0,18,0,14"/>

                        <TextBlock Text="한 줄 요약" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TitleTextBrush}"/>
                        <TextBlock Text="{Binding WeeklyInsight}"
                                   Style="{StaticResource DashboardCardSubTextStyle}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- 월별 달력 + 상세 -->
                <Border x:Name="MonthHistoryCard" Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Style="{StaticResource DashboardCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="월별 히스토리" Style="{StaticResource DashboardCardTitleStyle}"/>
                                <TextBlock Text="날짜를 눌러 퍼스널 컬러와 지표를 확인하세요."
                                           Style="{StaticResource DashboardCardSubTextStyle}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="선택 해제"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Height="30" FontSize="12" Padding="10,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding ClearCalendarSelectionCommand}"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,12">
                            <Button Content="‹" Style="{StaticResource CalendarNavButtonStyle}" Command="{Binding PreviousMonthCommand}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding DisplayMonthLabel}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TitleTextBrush}" VerticalAlignment="Center" MinWidth="120" TextAlignment="Center"/>
                            <Button Content="›" Style="{StaticResource CalendarNavButtonStyle}" Command="{Binding NextMonthCommand}" Margin="12,0,0,0"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="2" Columns="7" Margin="0,0,0,6">
                            <TextBlock Text="일" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="월" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="화" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="수" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="목" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="금" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="토" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                        </UniformGrid>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding CalendarCells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="52" Margin="2">
                                                <Border Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        CornerRadius="10"
                                                        Background="{StaticResource SurfaceSubtleBrush}"
                                                        Opacity="0.65">
                                                    <TextBlock Text="{Binding DisplayDay}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Top"
                                                               Margin="0,2,6,0"
                                                               Opacity="0.55"/>
                                                </Border>
                                                <Button Visibility="{Binding IsPlaceholder, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                                        Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CalendarDayCellButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                                    <Setter Property="Background" Value="{StaticResource RoseSoftBackgroundBrush}"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsToday}" Value="True"/>
                                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource RoseOutlineLightBrush}"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="{Binding DisplayDay}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TitleTextBrush}" HorizontalAlignment="Right"/>
                                                        <Border Grid.Row="1" Height="4" CornerRadius="2" Margin="0,6,0,0"
                                                                Background="{Binding IndicatorBrush}"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding PersonalShort}" FontSize="10"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0"
                                                                   Visibility="{Binding HasRecord, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,16,0,0"
                                        Padding="14,12"
                                        CornerRadius="12"
                                        Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource NeutralBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="선택한 날"
                                                   FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding SelectedDetailDateText}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TitleTextBrush}"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding SelectedCell, Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <TextBlock Text="달력에서 날짜를 선택하면 상세가 표시됩니다."
                                                   Style="{StaticResource DashboardCardSubTextStyle}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding SelectedCell, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}"/>

                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding SelectedCell, Converter={StaticResource NullToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Border Width="28" Height="28" CornerRadius="8"
                                                        Background="{Binding SelectedDetailSwatchBrush}"
                                                        BorderBrush="{StaticResource NeutralBorderBrush}" BorderThickness="1"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedDetailPersonalColor}" FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{StaticResource TitleTextBrush}"/>
                                                    <TextBlock Text="{Binding SelectedDetailMetricsLine}" FontSize="12"
                                                               Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedDetailNote}"
                                                       Style="{StaticResource DashboardCardSubTextStyle}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="20"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 주간 카드 아래: 안내 -->
                <Border x:Name="HistoryHintCard" Grid.Row="2" Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <TextBlock Text="기록에 대해" Style="{StaticResource DashboardCardTitleStyle}"/>
                        <!--실서비스에서는 분석 API·로컬 DB와 연동해 자동으로 채워지게, 지금 화면은 흐름 확인용 샘플 데이터
                        같은 날 여러 번 측정했다면 가장 최근 결과만 달력에 표시하는 식으로?-->
                        <TextBlock Style="{StaticResource DashboardCardSubTextStyle}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"
                                   Text="샘플 샘플샘플샘플 샘플샘플샘플샘플샘플 샘플샘플샘플샘플샘플샘플샘플샘플샘플 샘플 샘플샘플 샘플"/>
                        <TextBlock Style="{StaticResource DashboardCardSubTextStyle}" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"
                                   Text="샘플 샘플샘플샘플 샘플샘플샘플샘플샘플 샘플샘플샘플샘플샘플샘플샘플샘플샘플 샘플 샘플샘플 샘플"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
