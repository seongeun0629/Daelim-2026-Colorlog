<Window x:Class="Colorlog.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Colorlog"
        xmlns:views="clr-namespace:Colorlog.Views.Pages"
        xmlns:viewmodel ="clr-namespace:Colorlog.ViewModels"
        mc:Ignorable="d"
        Title="Colorlog" Height="900" Width="1440"
        MinHeight="760" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Window.Resources>

        <DataTemplate DataType="{x:Type viewmodel:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodel:LiveAnalysisViewModel}">
            <views:LiveAnalysisView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodel:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodel:BeautyLogViewModel}">
            <views:BeautyLogView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodel:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <Storyboard x:Key="OpenSidebar">
            <DoubleAnimation Storyboard.TargetProperty="Width" To="260" Duration="0:0:0.2"/>

        </Storyboard>

        <Storyboard x:Key="CloseSidebar">
            <DoubleAnimation Storyboard.TargetProperty="Width" To="80" Duration="0:0:0.2"/>

        </Storyboard>
    </Window.Resources>
    <Grid>
        <Border Background="{StaticResource AppShellBackgroundBrush}"/>
        <Border Background="{StaticResource AppShellAuroraOrbRoseBrush}" IsHitTestVisible="False"/>
        <Border Background="{StaticResource AppShellAuroraOrbLilacBrush}" IsHitTestVisible="False"/>
        <Border Background="{StaticResource AppShellAuroraOrbMintBrush}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="{StaticResource AppShellSidebarHostMargin}" Canvas.ZIndex="10">
                <Border x:Name="SidebarBorder" Width="260"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Effect="{StaticResource ShellSidebarShadowEffect}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Storyboard="{StaticResource CloseSidebar}"/>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard Storyboard="{StaticResource OpenSidebar}"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Border Style="{StaticResource ShellSidebarPanelStyle}"
                            Padding="0,18,0,22"
                            Margin="0,0,6,0">

                            <Grid ClipToBounds="True">
                                <Border Background="{StaticResource FrostedGlassSheenBrush}" IsHitTestVisible="False"/>
                            <Grid x:Name="SidebarContentGrid" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 사이드바 헤더: 접힘 시 네비와 동일하게 좌우 여백 축소 + 토글 전폭 중앙 정렬(고정 80열 제거로 클리핑 방지) -->
                                    <Grid Grid.Row="0" Height="50">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Margin" Value="12,0,12,16"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Margin" Value="4,0,4,16"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="SidebarBrandText" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Style="{StaticResource SidebarBrandTitleStyle}" Text="Colorlog"/>
                                            <TextBlock Style="{StaticResource SidebarBrandSubtitleStyle}" Text="Personal color studio"/>
                                        </StackPanel>

                                        <ToggleButton x:Name="SidebarToggleButton" Content="&#xE700;"
                                            Grid.Column="0" HorizontalAlignment="Center" Margin="0,2,0,0"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="14"
                                            ToolTip="사이드바 접기/펼치기" Width="40" Height="40"
                                            IsChecked="{Binding IsSidebarExpanded, Mode=TwoWay}"  
                                            VerticalAlignment="Center">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton" BasedOn="{StaticResource SidebarToggleButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                            <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </Grid>

                                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                                        <ListBox x:Name="SidebarListBox" 
                                            BorderThickness="0"
                                            Background="Transparent" 
                                            Margin="4,0"
                                            ItemContainerStyle="{StaticResource SidebarNavListBoxItemStyle}"
                                            SelectedValuePath="Tag"
                                            SelectedValue="{Binding SelectedMenuTag, Mode=TwoWay}" 
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled">

                                            <ListBoxItem Tag="Dashboard" Cursor="Hand" ToolTip="나의 컬러 홈">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE10F;" Style="{StaticResource SidebarNavIconStyle}"/>
                                                    <TextBlock Text="나의 컬러 홈" Style="{StaticResource SidebarNavLabelStyle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="LiveAnalysis" Cursor="Hand" ToolTip="실시간 컬러 분석">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE722;" Style="{StaticResource SidebarNavIconStyle}"/>
                                                    <TextBlock Text="실시간 컬러 분석" Style="{StaticResource SidebarNavLabelStyle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="History" Cursor="Hand" ToolTip="컬러 히스토리">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE787;" Style="{StaticResource SidebarNavIconStyle}"/>
                                                    <TextBlock Text="컬러 히스토리" Style="{StaticResource SidebarNavLabelStyle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="BeautyLog" Cursor="Hand" ToolTip="퍼스널 뷰티템">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" Style="{StaticResource SidebarNavIconStyle}"/>
                                                    <TextBlock Text="퍼스널 뷰티템" Style="{StaticResource SidebarNavLabelStyle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ListBoxItem>

                                            <ListBoxItem Tag="Settings" Cursor="Hand" ToolTip="서비스 설정">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE713;" Style="{StaticResource SidebarNavIconStyle}"/>
                                                    <TextBlock Text="서비스 설정" Style="{StaticResource SidebarNavLabelStyle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ListBoxItem>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 콘텐츠 영역-->
            <Grid Grid.Column="1" Margin="{StaticResource AppShellContentHostMargin}" Background="Transparent">
                <ContentControl x:Name="ContentArea"
                    Margin="14,0,0,0"
                    Background="Transparent"
                    Content="{Binding CurrentView}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
