<Window x:Class="Colorlog.Views.ProfileSelectView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Colorlog"
        Width="480" SizeToContent="Height"
        MinHeight="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid>
        <!-- 배경 레이어 -->
        <Border Background="{StaticResource AppShellBackgroundBrush}"/>
        <Border Background="{StaticResource AppShellAuroraOrbRoseBrush}"  IsHitTestVisible="False"/>
        <Border Background="{StaticResource AppShellAuroraOrbLilacBrush}" IsHitTestVisible="False"/>
        <Border Background="{StaticResource AppShellAuroraOrbMintBrush}"  IsHitTestVisible="False"/>

        <!-- 컨텐츠 -->
        <StackPanel Margin="40,36">

            <TextBlock Text="Colorlog"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TitleTextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="프로필을 선택하거나 새로 만드세요."
                       FontSize="13"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,28"/>

            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,10"
                                Command="{Binding DataContext.SelectProfileCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource OutlineButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="40" Height="40" CornerRadius="20"
                                        Background="{StaticResource RoseSoftBackgroundBrush}"
                                        Margin="0,0,14,0">
                                    <TextBlock Text="{Binding UserName[0]}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleTextBrush}"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Gender"/>
                                                <Binding Path="Age"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="›"
                                           FontSize="20"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ 새 프로필 추가"
                    Style="{StaticResource OutlineButtonStyle}"
                    Height="48"
                    Margin="0,4,0,0"
                    Command="{Binding AddNewProfileCommand}"/>

        </StackPanel>
    </Grid>
</Window>