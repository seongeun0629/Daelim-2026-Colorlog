    <Style x:Key="BeautyProductCardChromeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassAsymmetricHighlightBrush}"/>
        <Setter Property="BorderThickness" Value="1.2,1,1.05,0.55"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ShellSidebarPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="{StaticResource FrostedGlassUltraThinMaterialBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LiquidGlassAsymmetricHighlightBrush}"/>
        <Setter Property="BorderThickness" Value="1.2,1,1.05,0.55"/>
        <Setter Property="ClipToBounds" Value="True"/>
