        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <Style x:Key="PageHeaderSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style x:Key="PageHeaderHintStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppBodyFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource CaptionTextBrush}"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="BeautyHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardTitleStyle}">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="BeautySubStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardSubTextStyle}"/>

    <Style x:Key="BeautyTabItemStyle" TargetType="TabItem">
        <Setter Property="Width" Value="148"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBg"
                        Background="{StaticResource GlassPillFaceBrush}"
                        BorderBrush="{StaticResource LiquidGlassAsymmetricHighlightSubtleBrush}"
                        BorderThickness="1,1,1.05,0.55"
                        CornerRadius="20"
                        Margin="0,0,10,0"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0"
                            ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBg" Property="Background" Value="{StaticResource GlassPillFaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBg" Property="Background" Value="{StaticResource PrimaryGlassTintedFillBrush}"/>
                            <Setter TargetName="TabBg" Property="BorderBrush" Value="{StaticResource LiquidGlassAsymmetricHighlightBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BeautyTabControlStyle" TargetType="TabControl">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True"
                          Margin="2,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Background="Transparent"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="False"
                                  Margin="0,0,0,12"/>

                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings -->
    <SolidColorBrush x:Key="SettingsGlassFaceBrush" Color="#45FFFFFF"/>
    <Style x:Key="SettingsGlassCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}"/>
    <Style x:Key="SettingsGlassInsetStyle" TargetType="Border" BasedOn="{StaticResource GlassInsetStyle}"/>
    <Style x:Key="SettingsGlassDividerStyle" TargetType="Border" BasedOn="{StaticResource GlassDividerStyle}"/>
    <Style x:Key="SettingsPageHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderTitleStyle}"/>
    <Style x:Key="SettingsPageHeaderSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderSubtitleStyle}"/>
    <Style x:Key="SettingsPageHeaderHintStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderHintStyle}"/>
    <Style x:Key="SettingsGlassCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardTitleStyle}"/>
    <Style x:Key="SettingsGlassCardSubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardSubTextStyle}"/>
    <Style x:Key="SettingsGlassSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardSectionTitleStyle}"/>

    <!-- 설정 화면-->
    <!-- 설정 라벨 스타일 -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GlassFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource LabelOnGlassBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SettingsGlassFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource GlassFieldLabelStyle}"/>

    <!-- 아웃라인 버튼 스타일 -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisualStyle}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{StaticResource FrostedGlassUltraThinMaterialBrush}"
                        BorderBrush="{StaticResource LiquidGlassAsymmetricHighlightBrush}"
                        BorderThickness="1.2,1,1.05,0.55"
                        CornerRadius="16"
                        Padding="14,0"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource FrostedGlassUltraThinMaterialHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 위험 아웃라인 버튼 (초기화) -->
    <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisualStyle}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DangerStrongTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{StaticResource DangerGlassAlertFaceBrush}"
                        BorderBrush="{StaticResource GlassAlertErrorBorderBrush}"
                        BorderThickness="1,1,1.05,0.55"
                        CornerRadius="16"
                        Padding="14,0"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.92"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 위험 솔리드 버튼 -->
    <Style x:Key="DangerSolidButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocusVisualStyle}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{StaticResource DangerGlassAlertFaceBrush}"
                        BorderBrush="{StaticResource GlassAlertErrorBorderBrush}"
                        BorderThickness="1,1,1.05,0.55"
                        CornerRadius="16"
                        Padding="14,0"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 공통 콤보박스-->
    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="{StaticResource GlassFormFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}"/>

    <!-- 슬라이더 스타일 -->
    <Style x:Key="LightSliderStyle" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource NeutralBorderBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{StaticResource WhiteBrush}"
                                                 Stroke="{StaticResource PrimaryBrush}"
                                                 StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>