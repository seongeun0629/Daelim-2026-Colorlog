    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ShellGlassFaceBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="ShellGlassInnerWashBrush" Color="#22FFFFFF"/>
    <!--
      SwiftUI .overlay(RoundedRectangle.stroke(LinearGradient(topLeading → bottomTrailing))) 포팅.
      StartPoint(0,0)=topLeading, EndPoint(1,1)=bottomTrailing, MappingMode=RelativeToBoundingBox.
      스톱: TL 스펙큘러 → 상·좌 소프트 페이드 → 대각선 중간 숨쉼 → 우·하 림 복귀 → BR 앵커.
    -->
    <LinearGradientBrush x:Key="LiquidGlassAsymmetricHighlightBrush"
                         MappingMode="RelativeToBoundingBox"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#44FFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#55FFFFFF" Offset="0.78"/>
        <GradientStop Color="#C8FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassAsymmetricHighlightHoverBrush"
                         MappingMode="RelativeToBoundingBox"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#58FFFFFF" Offset="0.3"/>
        <GradientStop Color="#0CFFFFFF" Offset="0.5"/>
        <GradientStop Color="#66FFFFFF" Offset="0.78"/>
        <GradientStop Color="#D8FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidGlassAsymmetricHighlightSubtleBrush"
                         MappingMode="RelativeToBoundingBox"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#B0FFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="0.3"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
        <GradientStop Color="#44FFFFFF" Offset="0.78"/>
        <GradientStop Color="#A8FFFFFF" Offset="1"/>
    </LinearGradientBrush>

