<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
<!--색상-->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF7575"/>
    <SolidColorBrush x:Key="SelectedBgBrush" Color="#FFF2F2"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EEEEEE"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1E293B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF64748B"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5252"/>

    <!-- 타이포 계층: Display → Title → Body → Caption (유리 위 가독성 강화) -->
    <SolidColorBrush x:Key="TitleTextBrush" Color="#FF0F172A"/>
    <SolidColorBrush x:Key="BodyTextBrush" Color="#FF1E293B"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF475569"/>
    <SolidColorBrush x:Key="CaptionTextBrush" Color="#FF64748B"/>
    <SolidColorBrush x:Key="LabelOnGlassBrush" Color="#FF334155"/>
    <SolidColorBrush x:Key="SidebarHoverBgBrush" Color="#4DFFF1F3"/>
    <SolidColorBrush x:Key="SidebarSelectedBgBrush" Color="#66FCE4E8"/>
    <SolidColorBrush x:Key="SidebarSelectedTextBrush" Color="#FFB24E67"/>

    <!-- 디자인 토큰: Effect/그라데이션용 Color -->
    <Color x:Key="ShadowSlate900Color">#FF111827</Color>
    <!-- Specular Highlight Edge · 테두리 그라데이션 스톱 -->
    <Color x:Key="GlassBorderHighlightStopColor">#FFFFFFFF</Color>
    <Color x:Key="GlassBorderHighlightSoftStopColor">#E6FFFFFF</Color>
    <Color x:Key="GlassBorderMidStopColor">#88FFFFFF</Color>
    <Color x:Key="GlassBorderLowStopColor">#44FFFFFF</Color>
    <Color x:Key="GlassBorderFeatherStopColor">#1AFFFFFF</Color>
    <Thickness x:Key="GlassCardBorderThickness">1.5</Thickness>
    <Thickness x:Key="ShellSidebarBorderThickness">1.5</Thickness>
    <sys:Double x:Key="ShellSidebarRightEdgeWidth">2</sys:Double>
    <Thickness x:Key="GlassCardPadding">26,28</Thickness>
    <Thickness x:Key="GlassCardOuterMargin">0,0,16,16</Thickness>
    <Color x:Key="GlassShellEdgeHighlightColor">#E6FFFFFF</Color>
    <Color x:Key="GlassShellEdgeShadowColor">#40111827</Color>

    <Thickness x:Key="AppShellPagePadding">36,22,28,36</Thickness>
    <Thickness x:Key="AppShellSidebarHostMargin">20,20,0,20</Thickness>
    <Thickness x:Key="AppShellContentHostMargin">14,20,20,20</Thickness>
    <Thickness x:Key="PageHeaderBottomMargin">0,0,0,32</Thickness>
    <Thickness x:Key="PageSectionBottomMargin">0,0,0,24</Thickness>

    <!-- 앱 셸 최하단: 맑은 화이트·연그레이 파스텔 (콘텐츠 시선 분산 최소) -->
    <LinearGradientBrush x:Key="AppShellBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFF2F6" Offset="0"/>
        <GradientStop Color="#FFEDF7FF" Offset="0.5"/>
        <GradientStop Color="#FFFFFAF2" Offset="1"/>
    </LinearGradientBrush>

    <!-- 유리 카드 · 부드러운 부유 그림자 (넓게 퍼지는 앰비언트) -->
    <DropShadowEffect x:Key="GlassCardShadowEffect"
                      BlurRadius="36"
                      ShadowDepth="5"
                      Direction="270"
                      Opacity="0.065"
                      Color="Black"/>
    <DropShadowEffect x:Key="GlassCardShadowHoverEffect"
                      BlurRadius="42"
                      ShadowDepth="7"
                      Direction="270"
                      Opacity="0.085"
                      Color="Black"/>
    <DropShadowEffect x:Key="ShellSidebarShadowEffect"
                      BlurRadius="32"
                      ShadowDepth="6"
                      Direction="270"
                      Opacity="0.09"
                      Color="Black"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFFFF"/>
    <!-- 사이드바: 카드보다 투명 · 배경 투과 -->
    <SolidColorBrush x:Key="ShellGlassFaceBrush" Color="#28FFFFFF"/>
    <SolidColorBrush x:Key="ShellGlassInnerWashBrush" Color="#18FFF8FA"/>
    <LinearGradientBrush x:Key="ShellGlassPanelBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassPillFaceBrush" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="GlassPillFaceHoverBrush" Color="#62FFFFFF"/>

    <!-- 사이드바 · 콘텐츠 쪽 우측 경계 림 (세로 스펙큘러) -->
    <LinearGradientBrush x:Key="ShellSidebarRightEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#D9FFFFFF" Offset="0.2"/>
        <GradientStop Color="#77FFFFFF" Offset="0.55"/>
        <GradientStop Color="#33FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ShellSidebarEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassShellEdgeHighlightColor}" Offset="0"/>
        <GradientStop Color="#88FFFFFF" Offset="0.45"/>
        <GradientStop Color="#44FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShellContentDividerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#00CBD5E1" Offset="0"/>
        <GradientStop Color="#66CBD5E1" Offset="0.5"/>
        <GradientStop Color="#00CBD5E1" Offset="1"/>
    </LinearGradientBrush>

    <!-- 글래스모피즘 · 카드 면 (반투명 프로스트 — 배경이 비치는 블러 느낌) -->
    <SolidColorBrush x:Key="GlassCardFaceBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="GlassCardFaceHoverBrush" Color="#6BFFFFFF"/>
    <SolidColorBrush x:Key="GlassInsetFaceBrush" Color="#4DFFFFFF"/>
    <SolidColorBrush x:Key="GlassInsetFaceHoverBrush" Color="#59FFFFFF"/>

    <!-- 카드 면: ~35–42% 흰색 + 상단 살짝 밝게 (불투명 백판 X) -->
    <LinearGradientBrush x:Key="GlassCardFaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6BFFFFFF" Offset="0"/>
        <GradientStop Color="#59FFFFFF" Offset="0.5"/>
        <GradientStop Color="#52FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardFaceHoverGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#75FFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
        <GradientStop Color="#5CFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassInsetFaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0"/>
        <GradientStop Color="#4DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassInsetFaceHoverGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#55FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- 제품 카드 등 내부 오버레이용 -->
    <LinearGradientBrush x:Key="GlassCardSpecularWashBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#70FFFFFF" Offset="0"/>
        <GradientStop Color="#28FFFFFF" Offset="0.32"/>
        <GradientStop Color="#00FFFFFF" Offset="0.58"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassCardInnerRimBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassInsetSpecularWashBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassFormFieldBrush" Color="#F2FFFFFF"/>

    <!-- 카드 · 공통 유리 테두리 (상단 밝은 림 → 중간 → 하단 페더) -->
    <LinearGradientBrush x:Key="GlassBorderGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassBorderHighlightStopColor}" Offset="0"/>
        <GradientStop Color="{StaticResource GlassBorderHighlightSoftStopColor}" Offset="0.14"/>
        <GradientStop Color="{StaticResource GlassBorderMidStopColor}" Offset="0.42"/>
        <GradientStop Color="{StaticResource GlassBorderLowStopColor}" Offset="0.72"/>
        <GradientStop Color="{StaticResource GlassBorderFeatherStopColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- 사이드바 외곽 유리 테두리 (전체 둘레) -->
    <LinearGradientBrush x:Key="ShellSidebarGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FFFFFF" Offset="0"/>
        <GradientStop Color="#B3FFFFFF" Offset="0.35"/>
        <GradientStop Color="#55FFFFFF" Offset="0.7"/>
        <GradientStop Color="#28FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="ShellSidebarPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="{StaticResource ShellGlassPanelBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ShellSidebarGlassBorderBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource ShellSidebarBorderThickness}"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 중립 표면 · 보더 (반투명 유리 톤) -->
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="NeutralBorderStrongBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#66FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#42FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceCardShellBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="NeutralChipBackgroundBrush" Color="#70FFFFFF"/>
    <SolidColorBrush x:Key="DangerGlassSectionBrush" Color="#99FFF5F5"/>

    <!-- 로즈 톤 (메이크업 배지·설정 UI) -->
    <SolidColorBrush x:Key="RoseSoftBackgroundBrush" Color="#FFFFF1F2"/>
    <SolidColorBrush x:Key="RoseBadgeBorderBrush" Color="#FFFECACA"/>
    <SolidColorBrush x:Key="RoseSelectedBackgroundBrush" Color="#FFFCE4E8"/>
    <SolidColorBrush x:Key="RoseSelectedBorderBrush" Color="#FFE08E9B"/>
    <SolidColorBrush x:Key="RoseEmphasisTextBrush" Color="#FFBE123C"/>
    <SolidColorBrush x:Key="RoseOutlineLightBrush" Color="#FFFECDD3"/>

    <!-- 위험 액션 -->
    <SolidColorBrush x:Key="DangerSurfaceBackgroundBrush" Color="#FFFFF8F8"/>
    <SolidColorBrush x:Key="DangerStrongTextBrush" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="DangerOutlineBorderBrush" Color="#FFFCA5A5"/>
    <!-- 초기화 구역: 아주 옅은 붉은 테두리(배경은 카드와 동일하게 두고 경고만 암시) -->
    <SolidColorBrush x:Key="DangerSubtleSectionBorderBrush" Color="#33F87171"/>

    <!-- 스킨케어 성공 톤 -->
    <SolidColorBrush x:Key="SuccessSoftBackgroundBrush" Color="#FFECFDF5"/>
    <SolidColorBrush x:Key="SuccessSoftBorderBrush" Color="#FFA7F3D0"/>
    <SolidColorBrush x:Key="SuccessDeepTextBrush" Color="#FF047857"/>

    <!-- 칩·스와치 -->
    <SolidColorBrush x:Key="SwatchStrokeBrush" Color="#33000000"/>
    <SolidColorBrush x:Key="CaptionOnNeutralBrush" Color="#FF475569"/>

    <!--사이드바-->
    <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="192"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NavBg"
                                CornerRadius="14"
                                Background="Transparent"
                                Padding="10">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavBg" Property="Background" Value="#26FF8A8A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavBg" Property="Background" Value="#40FF8A8A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                <Setter Property="Width" Value="52"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="1"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Visibility" Value="Collapsed"/>
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                         To="0" Duration="0:0:0.3"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>

                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                         To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarBottomActionsStyle" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.2" Value="{x:Static Visibility.Collapsed}"/>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarBrandTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SidebarLabelStyle}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <Style x:Key="SidebarBrandSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SidebarLabelStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="SidebarNavLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SidebarLabelStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
    </Style>

    <Style x:Key="SidebarToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="{StaticResource GlassFormFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#FF000000" Opacity="0.08"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleChrome" Property="Background" Value="{StaticResource GlassPillFaceHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter  Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentPillButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}"
                                Background="#FFFF8A8A">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="4"
                                                  Direction="270"
                                                  Color="#FFFF8A8A"
                                                  Opacity="0.45"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#FFFF9A9A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#FFFF7A7A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentOutlinePillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
        <Setter Property="Foreground" Value="#FFFF8A8A"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}"
                                Background="#FFFFFFFF"
                                BorderBrush="#FFFF8A8A"
                                BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="2"
                                                  Direction="270"
                                                  Color="#FF000000"
                                                  Opacity="0.06"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#14FF8A8A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#26FF8A8A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- 글래스모피즘 · 공통 카드 (LiveAnalysis CardStyle 포함) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassCardFaceGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="{StaticResource GlassCardBorderThickness}"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="{StaticResource GlassCardPadding}"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform/>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource GlassCardShadowEffect}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassCardFaceHoverGradientBrush}"/>
                <Setter Property="Effect" Value="{StaticResource GlassCardShadowHoverEffect}"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="-2"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassInsetStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassInsetFaceGradientBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GlassInsetFaceHoverGradientBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dashboard · 전역 페이지 카드 -->
    <Style x:Key="DashboardCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <Style x:Key="DashboardCardSubTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style x:Key="DashboardAccentValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <Style x:Key="DashboardCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="28,30"/>
        <Setter Property="Margin" Value="{StaticResource GlassCardOuterMargin}"/>
    </Style>

    <Style x:Key="DashboardMetricTagStyle" TargetType="Border" BasedOn="{StaticResource GlassInsetStyle}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- 대시보드 피부 지표 등: OS 기본색 대신 앱 토큰 -->
    <Style x:Key="DashboardProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="PART_Track" CornerRadius="5" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" CornerRadius="5" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Beauty Log · 제품 카드: 외곽=그림자·클립, 내부=방사형 유리 면 -->
    <Style x:Key="ProductCardContainerStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="MinWidth" Value="240"/>
        <Setter Property="MaxWidth" Value="328"/>
        <Setter Property="Margin" Value="0,0,20,20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="{x:Null}"/>
    </Style>

    <Style x:Key="TagChipStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{StaticResource NeutralChipBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

<!--Primary 버튼 스타일-->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" 
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

<!-- 필터 버튼 (토글) -->
    <Style x:Key="FilterToggleStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="border" Background="{StaticResource GlassPillFaceBrush}" CornerRadius="15" 
                        BorderBrush="{StaticResource GlassBorderGradientBrush}" BorderThickness="1"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource GlassPillFaceHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FadeInStyle" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Opacity" Value="0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, ElementName=RbMakeup}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!--섹션 타이틀 (큰 블록/옛 화면용)-->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <!-- 카드 내부 소제목 -->
    <Style x:Key="CardSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource LabelOnGlassBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="AnalysisCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardTitleStyle}">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="AnalysisCardSubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardSubTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <!-- 페이지 최상단 타이틀 -->
    <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TitleTextBrush}"/>
    </Style>

    <Style x:Key="PageHeaderSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style x:Key="PageHeaderHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource CaptionTextBrush}"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>

    <Style x:Key="BeautyHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardTitleStyle}">
        <Setter Property="FontSize" Value="18"/>
    </Style>

    <Style x:Key="BeautySubStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardSubTextStyle}"/>

    <Style x:Key="BeautyTabItemStyle" TargetType="TabItem">
        <Setter Property="Width" Value="135"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBg"
                        Background="{StaticResource GlassPillFaceBrush}"
                        BorderBrush="{StaticResource GlassBorderGradientBrush}"
                        BorderThickness="1"
                        CornerRadius="22"
                        Margin="0,0,8,0"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0"
                            ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBg" Property="Background" Value="{StaticResource GlassPillFaceHoverBrush}"/>
                            <Setter TargetName="TabBg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBg" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="TabBg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BeautyTabControlStyle" TargetType="TabControl">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True"
                          Margin="2,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TabPanel Grid.Row="0"
                                  IsItemsHost="True"
                                  Background="Transparent"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="False"
                                  Margin="0,0,0,12"/>

                        <Border Grid.Row="1" Background="Transparent">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings 등 레거시 키 → 글로벌 글래스 별칭 -->
    <SolidColorBrush x:Key="SettingsGlassFaceBrush" Color="#59FFFFFF"/>
    <Style x:Key="SettingsGlassCardStyle" TargetType="Border" BasedOn="{StaticResource DashboardCardStyle}"/>
    <Style x:Key="SettingsGlassInsetStyle" TargetType="Border" BasedOn="{StaticResource GlassInsetStyle}"/>
    <Style x:Key="SettingsGlassDividerStyle" TargetType="Border" BasedOn="{StaticResource GlassDividerStyle}"/>
    <Style x:Key="SettingsPageHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderTitleStyle}"/>
    <Style x:Key="SettingsPageHeaderSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderSubtitleStyle}"/>
    <Style x:Key="SettingsPageHeaderHintStyle" TargetType="TextBlock" BasedOn="{StaticResource PageHeaderHintStyle}"/>
    <Style x:Key="SettingsGlassCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardTitleStyle}"/>
    <Style x:Key="SettingsGlassCardSubTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DashboardCardSubTextStyle}"/>
    <Style x:Key="SettingsGlassSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardSectionTitleStyle}"/>

<!-- 설정 화면 · 폼 공통 (SettingsView 등) -->
    <!-- 설정 라벨 스타일 -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="GlassFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="Foreground" Value="{StaticResource LabelOnGlassBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SettingsGlassFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource GlassFieldLabelStyle}"/>

    <!-- 아웃라인 버튼 스타일 -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16"
                        Padding="14,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource GlassPillFaceHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 위험 아웃라인 버튼 (초기화) -->
    <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DangerStrongTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerOutlineBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="16"
                        Padding="14,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource RoseSoftBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 위험 솔리드 버튼 (초기화 등 강조 액션) -->
    <Style x:Key="DangerSolidButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource DangerStrongTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="16"
                        Padding="14,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFB91C1C"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox (앱 공통) -->
    <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="{StaticResource GlassFormFieldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassBorderGradientBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}"/>

    <!-- 슬라이더 스타일 -->
    <Style x:Key="LightSliderStyle" TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource NeutralBorderBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{StaticResource WhiteBrush}"
                                                 Stroke="{StaticResource PrimaryBrush}"
                                                 StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>